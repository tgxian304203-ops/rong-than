# .env.example
# Nhiệm vụ: Mẫu biến môi trường cho frontend (Vite).
# Cách dùng:
#   1. Copy file này thành .env
#   2. Điền giá trị thật
#   3. KHÔNG commit .env lên GitHub (đã có trong .gitignore)

# ============================================================
# FRONTEND (Vite) — phải có tiền tố VITE_
# ============================================================

# Base URL cho API backend.
# - Khi dev: để trống → Vite proxy tự chuyển /api sang http://localhost:3000
# - Khi deploy (Render): đặt URL đầy đủ của backend
# Ví dụ:
#   VITE_API_BASE_URL=https://rong-than-api.onrender.com/api
VITE_API_BASE_URL=

# ============================================================
# GHI CHÚ
# ============================================================
# Các biến môi trường của BACKEND (MongoDB URI, JWT_SECRET,
# API key các nhà cung cấp...) KHÔNG đặt ở đây.
# Chúng nằm trong file .env của thư mục server/ (sẽ gửi ở bước sau).
#
# Tuyệt đối KHÔNG đặt API key thật vào file này và commit lên GitHub.